# Per-instance swebench harness reports -- re-committing these makes CI
# silently skip re-scoring instead of using the new patch. Nested under
# each model's own <model_key>/logs/run_evaluation/ -- see config.py's
# MODEL_REGISTRY/model_paths().
SWE-bench-lite_agent/*/logs/run_evaluation/

# Downloaded GitHub Actions artifact (zip and/or extracted folder).
swebench-evaluation-results.zip
SWE-bench-lite_agent/swebench-evaluation-results/
SWE-bench-lite_agent/swebench-evaluation-results.zip

# Aggregate local-run reports written to report_dir="." -- unused clutter.
# Covers every registered model's run_id (e.g. quixbugs_swebench_lite_agent,
# quixbugs_swebench_lite_agent_sonnet5 -- see config.MODEL_REGISTRY).
SWE-bench-lite_agent/*.quixbugs_swebench_lite_agent*.json

# generate_artefact_components.py's output dir (normally outside this
# repo, so this only matters if --out-dir is pointed inside it).
/artefact-generator/
